    "var_4604360827fb": {
      "type": "variant",
      "label": "Cadastro — percurso da resposta",
      "parentId": "var_2e6ccd97662e",
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 1000
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n  .signup-copy { font-family: 'DM Sans', sans-serif; }\n  .signup-display { font-family: 'Space Grotesk', sans-serif; }\n</style>\n<main class=\"signup-copy min-h-screen bg-[#f4f3ed] text-[#1a3028]\" data-kid=\"1\" data-name=\"main signup page container\">\n    <div class=\"mx-auto max-w-[1200px] px-4 pb-8 sm:px-9 sm:pb-10 lg:px-12\" data-kid=\"1-1\" data-name=\"page content wrapper\">\n        <header class=\"flex h-[72px] items-center justify-between border-b border-[#dcded4]\" data-kid=\"1-1-1\" data-name=\"header navigation bar\">\n            <a class=\"signup-display text-[17px] font-bold tracking-[-0.055em] text-[#193c2f]\" data-kid=\"1-1-1-1\" data-name=\"application name link\" href=\"/\">\n                Form Builder\n            </a>\n        </header>\n        <section aria-labelledby=\"signup-heading\" class=\"pt-4 sm:pt-10\" data-kid=\"1-1-2\" data-name=\"signup process section\">\n            <div class=\"mb-4 max-w-[780px] sm:mb-6\" data-kid=\"1-1-2-1\" data-name=\"introductory text container\">\n                <h1 class=\"signup-display text-[28px] font-semibold leading-[1.08] tracking-[-0.055em] text-[#17392d] sm:text-[42px]\" data-kid=\"1-1-2-1-1\" data-name=\"main page headline\" id=\"signup-heading\">\n                    Publique formulários. Receba respostas no painel.\n                </h1>\n                <p class=\"mt-3 hidden max-w-[660px] text-[15px] leading-6 text-[#58675f] sm:block sm:text-[16px]\" data-kid=\"1-1-2-1-2\" data-name=\"page description text\">\n                    Uma resposta percorre um caminho simples — do primeiro campo até chegar organizada para você.\n                </p>\n            </div>\n            <section aria-label=\"Exemplo do percurso de uma resposta\" class=\"overflow-hidden rounded-[22px] border border-[#d7ddd2] bg-[#e9ece3]\" data-kid=\"1-1-2-2\" data-name=\"form process visualization section\">\n                <div aria-label=\"Formulário publicado, pessoa responde, resposta chega ao painel\" class=\"grid grid-cols-[1fr_auto_1fr_auto_1fr] items-center gap-x-2 px-4 py-3 md:hidden\" data-kid=\"1-1-2-2-2\" data-name=\"mobile process visualization container\">\n                    <span class=\"text-[10px] font-semibold leading-[1.25] text-[#203a30]\" data-kid=\"1-1-2-2-2-1\" data-name=\"mobile process step label 1\">\n                        Formulário publicado\n                    </span>\n                    <span aria-hidden=\"true\" class=\"icon-arrow-right text-[12px] text-[#4b8061]\" data-kid=\"1-1-2-2-2-2\" data-name=\"mobile process step arrow 1\">\n                    </span>\n                    <span class=\"text-center text-[10px] font-semibold leading-[1.25] text-[#203a30]\" data-kid=\"1-1-2-2-2-3\" data-name=\"mobile process step label 2\">\n                        Pessoa responde\n                    </span>\n                    <span aria-hidden=\"true\" class=\"icon-arrow-right text-[12px] text-[#4b8061]\" data-kid=\"1-1-2-2-2-4\" data-name=\"mobile process step arrow 2\">\n                    </span>\n                    <span class=\"text-right text-[10px] font-semibold leading-[1.25] text-[#203a30]\" data-kid=\"1-1-2-2-2-5\" data-name=\"mobile process step label 3\">\n                        Resposta no painel\n                    </span>\n                </div>\n                <ol class=\"hidden md:grid md:grid-cols-[1.08fr_0.75fr_1fr]\" data-kid=\"1-1-2-2-1\" data-name=\"process steps list\">\n                    <li class=\"relative border-b border-[#d2d8cd] px-5 py-5 sm:px-7 md:border-b-0 md:border-r md:py-6\" data-kid=\"1-1-2-2-1-1\" data-name=\"first process step item\">\n                        <div class=\"mb-4 flex items-baseline gap-3\" data-kid=\"1-1-2-2-1-1-1\" data-name=\"first step header container\">\n                            <span class=\"signup-display text-[12px] font-bold text-[#829387]\" data-kid=\"1-1-2-2-1-1-1-1\" data-name=\"step number label\">\n                                01\n                            </span>\n                            <h2 class=\"text-[14px] font-semibold text-[#203a30]\" data-kid=\"1-1-2-2-1-1-1-2\" data-name=\"step title text\">\n                                Formulário publicado\n                            </h2>\n                        </div>\n                        <div class=\"max-w-[370px] rounded-[13px] border border-[#dfe3d9] bg-[#fbfbf7] px-4 py-3.5 shadow-[0_5px_18px_rgba(25,48,38,0.04)]\" data-kid=\"1-1-2-2-1-1-2\" data-name=\"form sample container\">\n                            <p class=\"mb-2 text-[10px] font-semibold uppercase tracking-[0.11em] text-[#879288]\" data-kid=\"1-1-2-2-1-1-2-1\" data-name=\"form sample label\">\n                                Exemplo de formulário\n                            </p>\n                            <p class=\"text-[13px] font-semibold text-[#233a30]\" data-kid=\"1-1-2-2-1-1-2-2\" data-name=\"form sample title\">\n                                Fale sobre seu projeto\n                            </p>\n                            <p class=\"mt-2.5 text-[11px] font-medium text-[#55635b]\" data-kid=\"1-1-2-2-1-1-2-3\" data-name=\"form sample question\">\n                                Qual serviço você procura?\n                            </p>\n                            <div class=\"mt-2 flex flex-wrap gap-1.5\" data-kid=\"1-1-2-2-1-1-2-4\" data-name=\"form sample options container\">\n                                <span class=\"rounded-full border border-[#dde2d9] px-2.5 py-1 text-[10px] text-[#66736c]\" data-kid=\"1-1-2-2-1-1-2-4-1\" data-name=\"form option badge\">\n                                    Site novo\n                                </span>\n                                <span class=\"rounded-full border border-[#a9c8b5] bg-[#e6f1e8] px-2.5 py-1 text-[10px] font-semibold text-[#286246]\" data-kid=\"1-1-2-2-1-1-2-4-2\" data-name=\"selected form option badge\">\n                                    Captação de leads\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                    <li class=\"relative flex flex-col justify-center border-b border-[#d2d8cd] px-5 py-5 sm:px-7 md:border-b-0 md:border-r md:px-6 md:py-6\" data-kid=\"1-1-2-2-1-2\" data-name=\"second process step item\">\n                        <div class=\"mb-4 flex items-baseline gap-3\" data-kid=\"1-1-2-2-1-2-1\" data-name=\"second step header container\">\n                            <span class=\"signup-display text-[12px] font-bold text-[#829387]\" data-kid=\"1-1-2-2-1-2-1-1\" data-name=\"step number label\">\n                                02\n                            </span>\n                            <h2 class=\"text-[14px] font-semibold text-[#203a30]\" data-kid=\"1-1-2-2-1-2-1-2\" data-name=\"step title text\">\n                                Pessoa responde\n                            </h2>\n                        </div>\n                        <p class=\"text-[11px] text-[#78857b]\" data-kid=\"1-1-2-2-1-2-2\" data-name=\"second step description\">\n                            A escolha feita no formulário\n                        </p>\n                        <div class=\"mt-2 flex items-center gap-2.5 border-b border-[#cdd5ca] pb-3\" data-kid=\"1-1-2-2-1-2-3\" data-name=\"response example container\">\n                            <span class=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#d7e5d8] text-[13px] font-bold text-[#286246]\" data-kid=\"1-1-2-2-1-2-3-1\" data-name=\"checkmark icon\">\n                                ✓\n                            </span>\n                            <p class=\"text-[13px] font-semibold leading-5 text-[#244334]\" data-kid=\"1-1-2-2-1-2-3-2\" data-name=\"response choice text\">\n                                Captação de leads\n                            </p>\n                        </div>\n                        <p class=\"mt-3 text-[10px] leading-4 text-[#7a867c]\" data-kid=\"1-1-2-2-1-2-4\" data-name=\"step disclaimer text\">\n                            Uma resposta ilustrativa, não um dado real.\n                        </p>\n                    </li>\n                    <li class=\"px-5 py-5 sm:px-7 md:py-6\" data-kid=\"1-1-2-2-1-3\" data-name=\"third process step item\">\n                        <div class=\"mb-4 flex items-baseline gap-3\" data-kid=\"1-1-2-2-1-3-1\" data-name=\"third step header container\">\n                            <span class=\"signup-display text-[12px] font-bold text-[#829387]\" data-kid=\"1-1-2-2-1-3-1-1\" data-name=\"step number label\">\n                                03\n                            </span>\n                            <h2 class=\"text-[14px] font-semibold text-[#203a30]\" data-kid=\"1-1-2-2-1-3-1-2\" data-name=\"step title text\">\n                                Resposta chega ao painel\n                            </h2>\n                        </div>\n                        <div class=\"border-y border-[#cdd5ca] py-2.5\" data-kid=\"1-1-2-2-1-3-2\" data-name=\"dashboard visualization container\">\n                            <div class=\"flex items-center justify-between gap-3 pb-2.5\" data-kid=\"1-1-2-2-1-3-2-1\" data-name=\"dashboard header row\">\n                                <p class=\"text-[11px] font-medium text-[#59685e]\" data-kid=\"1-1-2-2-1-3-2-1-1\" data-name=\"dashboard form title\">\n                                    Fale sobre seu projeto\n                                </p>\n                            </div>\n                            <div class=\"grid grid-cols-[1fr_auto] items-center gap-3 border-t border-[#d7ddd2] pt-2.5\" data-kid=\"1-1-2-2-1-3-2-2\" data-name=\"dashboard answer row\">\n                                <div data-kid=\"1-1-2-2-1-3-2-2-1\" data-name=\"answer details container\">\n                                    <p class=\"text-[10px] text-[#879288]\" data-kid=\"1-1-2-2-1-3-2-2-1-1\" data-name=\"answer question text\">\n                                        Qual serviço você procura?\n                                    </p>\n                                    <p class=\"mt-0.5 text-[12px] font-semibold text-[#244334]\" data-kid=\"1-1-2-2-1-3-2-2-1-2\" data-name=\"answer value text\">\n                                        Captação de leads\n                                    </p>\n                                </div>\n                                <span aria-hidden=\"true\" class=\"icon-arrow-right text-[16px] text-[#4b8061]\" data-kid=\"1-1-2-2-1-3-2-2-2\" data-name=\"right arrow icon\">\n                                </span>\n                            </div>\n                        </div>\n                    </li>\n                </ol>\n            </section>\n            <section aria-labelledby=\"create-account-title\" class=\"mt-6 rounded-[22px] bg-[#173e31] px-5 py-6 text-[#f6f5ee] shadow-[0_16px_42px_rgba(25,55,43,0.12)] sm:px-8 sm:py-7\" data-kid=\"1-1-2-3\" data-name=\"create account section\">\n                <div class=\"mb-5 flex flex-col justify-between gap-1 sm:flex-row sm:items-end sm:gap-6\" data-kid=\"1-1-2-3-1\" data-name=\"section header container\">\n                    <div data-kid=\"1-1-2-3-1-1\" data-name=\"section header group\">\n                        <h2 class=\"signup-display text-[23px] font-semibold leading-tight tracking-[-0.04em] sm:text-[26px]\" data-kid=\"1-1-2-3-1-1-1\" data-name=\"create account headline\" id=\"create-account-title\">\n                            Crie sua conta para montar o formulário\n                        </h2>\n                        <p class=\"mt-1.5 text-[13px] leading-5 text-[#c8d7ca]\" data-kid=\"1-1-2-3-1-1-2\" data-name=\"section subheadline\">\n                            Depois do cadastro, você segue para o painel.\n                        </p>\n                    </div>\n                    <p class=\"hidden pb-1 text-[11px] text-[#a9c4b3] sm:block\" data-kid=\"1-1-2-3-1-2\" data-name=\"password tip text\">\n                        Leva só seu email e uma senha\n                    </p>\n                </div>\n                <div class=\"mb-4 hidden items-start gap-2.5 rounded-[10px] border border-[#a86e60] bg-[#49352f] px-3.5 py-3 text-[12px] leading-5 text-[#f0d5cc]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-4\" data-name=\"error alert box\" data-reason=\"visibility and content toggled by form submission result\" id=\"signup-error\" role=\"alert\">\n                    <span aria-hidden=\"true\" class=\"icon-circle-alert mt-0.5 shrink-0 text-[15px]\" data-kid=\"1-1-2-3-4-1\" data-name=\"alert icon\">\n                    </span>\n                    <span data-kid=\"1-1-2-3-4-2\" data-name=\"error message text\">\n                        Não foi possível criar sua conta. Confira os dados e tente novamente.\n                    </span>\n                </div>\n                <form action=\"#\" class=\"grid grid-cols-1 gap-x-4 gap-y-4 sm:grid-cols-2 lg:grid-cols-[1fr_1fr_180px] lg:items-end\" data-kid=\"1-1-2-3-2\" data-name=\"signup form\">\n                    <div data-kid=\"1-1-2-3-2-1\" data-name=\"email field container\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[#e6ede4]\" data-kid=\"1-1-2-3-2-1-1\" data-name=\"email label\" for=\"email\">\n                            Email\n                        </label>\n                        <input autocomplete=\"email\" class=\"h-[48px] w-full rounded-[10px] border border-[#dce4d9] bg-[#fbfbf7] px-3.5 text-[14px] text-[#23382e] placeholder:text-[#9aa39a] outline-none ring-offset-2 ring-offset-[#173e31] focus:border-[#d1e89c] focus:ring-2 focus:ring-[#d1e89c]\" data-kid=\"1-1-2-3-2-1-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"seu@email.com\" required=\"\" type=\"email\"/>\n                    </div>\n                    <div data-kid=\"1-1-2-3-2-2\" data-name=\"password field container\">\n                        <label class=\"mb-1.5 block text-[12px] font-semibold text-[#e6ede4]\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"password label\" for=\"password\">\n                            Senha\n                        </label>\n                        <input autocomplete=\"new-password\" class=\"h-[48px] w-full rounded-[10px] border border-[#dce4d9] bg-[#fbfbf7] px-3.5 text-[14px] text-[#23382e] placeholder:text-[#9aa39a] outline-none ring-offset-2 ring-offset-[#173e31] focus:border-[#d1e89c] focus:ring-2 focus:ring-[#d1e89c]\" data-kid=\"1-1-2-3-2-2-2\" data-name=\"password input field\" id=\"password\" minlength=\"6\" name=\"password\" placeholder=\"••••••••\" required=\"\" type=\"password\"/>\n                        <p class=\"mt-1.5 text-[11px] text-[#b7cbbd]\" data-kid=\"1-1-2-3-2-2-3\" data-name=\"password requirements text\">\n                            Mínimo de 6 caracteres\n                        </p>\n                    </div>\n                    <button class=\"inline-flex h-[48px] items-center justify-center gap-2 rounded-[10px] bg-[#d6e99e] px-5 text-[14px] font-bold text-[#173b2e] shadow-sm hover:bg-[#e2f0b9] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d6e99e] disabled:cursor-wait disabled:opacity-70\" data-kid=\"1-1-2-3-2-3\" data-name=\"submit account button\" type=\"submit\">\n                        Criar conta\n                        <span aria-hidden=\"true\" class=\"icon-arrow-right text-[15px]\" data-kid=\"1-1-2-3-2-3-1\" data-name=\"right arrow icon\">\n                        </span>\n                    </button>\n                </form>\n                <div class=\"mt-4 flex flex-col gap-2 border-t border-[#335646] pt-4 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"1-1-2-3-3\" data-name=\"form footer container\">\n                    <p aria-live=\"polite\" class=\"min-h-5 text-[12px] leading-5 text-[#c8d7ca]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-3-1\" data-name=\"form status message\" data-reason=\"text content updated dynamically by form submission state\" role=\"status\">\n                        Ao enviar, o botão informa que sua conta está sendo criada.\n                    </p>\n                    <p class=\"text-[12px] text-[#cad9cc]\" data-kid=\"1-1-2-3-3-2\" data-name=\"footer login prompt\">\n                        Já tem uma conta?\n                        <a class=\"inline-flex min-h-11 items-center font-semibold text-[#e2efc1] underline decoration-[#7c9c7a] underline-offset-4\" data-kid=\"1-1-2-3-3-2-1\" data-name=\"footer login link\" href=\"/login\">\n                            Fazer login\n                        </a>\n                    </p>\n                </div>\n            </section>\n            <p class=\"mx-auto mt-4 max-w-[720px] text-center text-[11px] leading-5 text-[#7a867c]\" data-kid=\"1-1-2-4\" data-name=\"page footer disclaimer\">\n                Seu email e senha serão usados para acessar o painel e acompanhar as respostas.\n            </p>\n        </section>\n    </div>\n</main>\n",
      "comments": [],
      "created": "2026-10-05T15:59:53.039671+00:00",
      "modified": "2026-10-05T16:06:20.405526+00:00",
      "id": "var_4604360827fb"
    },
    "var_71d56689bd1c": {
      "type": "variant",
      "label": "Cadastro — exemplo de formulário",
      "parentId": "var_2e6ccd97662e",
      "themeId": null,
      "rect": {
        "x": 4140,
        "y": 0,
        "w": 1280,
        "h": 1000
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n\n.signup-sans { font-family: 'DM Sans', sans-serif; }\n.signup-display { font-family: 'DM Serif Display', Georgia, serif; }\n@keyframes signup-spin { to { transform: rotate(360deg); } }\n.signup-spinner { animation: signup-spin 0.8s linear infinite; }\n</style>\n<div class=\"signup-sans min-h-screen bg-[#F6F3EC] text-[#18382F]\" data-kid=\"1\">\n    <header class=\"mx-auto flex h-[68px] max-w-[1440px] items-center px-5 sm:px-8 lg:px-12\" data-kid=\"1-1\">\n        <a aria-label=\"Form Builder\" class=\"group flex items-center gap-3 text-[#18382F] no-underline\" data-kid=\"1-1-1\" href=\"#\">\n            <span class=\"signup-display flex h-9 w-9 items-center justify-center rounded-[12px] bg-[#18382F] text-[21px] leading-none text-[#F6F3EC]\" data-kid=\"1-1-1-1\">\n                f\n            </span>\n            <span class=\"text-[15px] font-semibold tracking-[-0.03em]\" data-kid=\"1-1-1-2\">\n                Form Builder\n            </span>\n        </a>\n    </header>\n    <main class=\"mx-auto grid max-w-[1440px] items-center gap-9 px-5 pb-10 pt-4 sm:px-8 lg:min-h-[calc(100vh-68px)] lg:grid-cols-[minmax(0,1.22fr)_minmax(350px,0.78fr)] lg:gap-12 lg:px-12 lg:py-8 xl:gap-[72px]\" data-kid=\"1-2\">\n        <section aria-labelledby=\"intro-title\" class=\"min-w-0\" data-kid=\"1-2-1\">\n            <div class=\"max-w-[670px]\" data-kid=\"1-2-1-1\">\n                <h1 class=\"signup-display max-w-[620px] text-[39px] leading-[1.04] tracking-[-0.045em] text-[#18382F] sm:text-[48px] lg:text-[54px]\" data-kid=\"1-2-1-1-1\" id=\"intro-title\">\n                    Crie o formulário.\n                    <br class=\"hidden sm:block\" data-kid=\"1-2-1-1-1-1\"/>\n                    Receba a resposta.\n                </h1>\n                <p class=\"mt-3 max-w-[520px] text-[15px] leading-6 text-[#4F655B] sm:text-[16px]\" data-kid=\"1-2-1-1-2\">\n                    Monte seu primeiro formulário e acompanhe as respostas no painel.\n                </p>\n            </div>\n            <figure class=\"mt-6 overflow-hidden rounded-[24px] bg-[#18382F] p-4 shadow-[0_22px_55px_-32px_rgba(24,56,47,0.56)] sm:mt-7 sm:rounded-[28px] sm:p-5 lg:mt-8 lg:p-6\" data-kid=\"1-2-1-2\">\n                <div class=\"mb-3 flex items-center justify-between gap-3 sm:mb-4\" data-kid=\"1-2-1-2-1\">\n                    <h2 class=\"text-[14px] font-semibold tracking-[-0.01em] text-[#F8F5EC] sm:text-[15px]\" data-kid=\"1-2-1-2-1-1\">\n                        Exemplo de formulário\n                    </h2>\n                    <span class=\"shrink-0 text-[11px] font-medium text-[#CDD9C9] sm:text-xs\" data-kid=\"1-2-1-2-1-2\">\n                        Conteúdo ilustrativo\n                    </span>\n                </div>\n                <div class=\"grid items-stretch gap-3 lg:grid-cols-[minmax(0,1.2fr)_28px_minmax(145px,0.72fr)] lg:gap-2\" data-kid=\"1-2-1-2-2\">\n                    <div class=\"rounded-[17px] bg-[#FBF9F3] p-4 sm:rounded-[19px] sm:p-5\" data-kid=\"1-2-1-2-2-1\">\n                        <div class=\"flex items-start justify-between gap-3\" data-kid=\"1-2-1-2-2-1-1\">\n                            <div data-kid=\"1-2-1-2-2-1-1-1\">\n                                <h3 class=\"text-[17px] font-semibold leading-tight tracking-[-0.035em] text-[#18382F] sm:text-[19px]\" data-kid=\"1-2-1-2-2-1-1-1-1\">\n                                    Vamos conversar?\n                                </h3>\n                                <p class=\"mt-1 text-[12px] leading-5 text-[#6A786F]\" data-kid=\"1-2-1-2-2-1-1-1-2\">\n                                    Um exemplo simples de campo.\n                                </p>\n                            </div>\n                            <span aria-hidden=\"true\" class=\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#F2E2D2] text-[#A34D35]\" data-kid=\"1-2-1-2-2-1-1-2\">\n                                <span class=\"signup-display text-[15px]\" data-kid=\"1-2-1-2-2-1-1-2-1\">\n                                    1\n                                </span>\n                            </span>\n                        </div>\n                        <div class=\"mt-4\" data-kid=\"1-2-1-2-2-1-2\">\n                            <div class=\"mb-1.5 block text-[11px] font-semibold text-[#314B40]\" data-kid=\"1-2-1-2-2-1-2-1\">\n                                Seu email\n                            </div>\n                            <div class=\"flex h-[42px] items-center rounded-[10px] border border-[#D9DDD2] bg-white px-3 text-[13px] text-[#8B958D] shadow-[0_1px_2px_rgba(24,56,47,0.04)]\" data-kid=\"1-2-1-2-2-1-2-2\">\n                                seu@email.com\n                            </div>\n                        </div>\n                        <div class=\"mt-3 flex h-[39px] items-center justify-center gap-2 rounded-[10px] bg-[#E6E7D5] px-3 text-[12px] font-semibold text-[#4D5A43]\" data-kid=\"1-2-1-2-2-1-3\">\n                            Enviar resposta\n                            <span aria-hidden=\"true\" class=\"text-[14px] leading-none\" data-kid=\"1-2-1-2-2-1-3-1\">\n                                →\n                            </span>\n                        </div>\n                    </div>\n                    <div aria-hidden=\"true\" class=\"hidden items-center justify-center text-[18px] text-[#C6D6C0] lg:flex\" data-kid=\"1-2-1-2-2-2\">\n                        <i class=\"icon-arrow-right\" data-kid=\"1-2-1-2-2-2-1\" style=\"width:18px;height:18px\">\n                        </i>\n                    </div>\n                    <div class=\"grid grid-cols-[1fr_auto] items-center gap-x-2.5 gap-y-1 rounded-[15px] border border-[#DCE6CE] bg-[#E7EDD8] px-3.5 py-3.5 sm:rounded-[17px] sm:px-4 lg:grid-cols-1 lg:content-start lg:gap-y-2 lg:px-4 lg:py-4\" data-kid=\"1-2-1-2-2-3\">\n                        <div class=\"flex items-center gap-2 lg:gap-2.5\" data-kid=\"1-2-1-2-2-3-1\">\n                            <span aria-hidden=\"true\" class=\"flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#18382F] text-[#EAF0D8] sm:h-8 sm:w-8\" data-kid=\"1-2-1-2-2-3-1-1\">\n                                <span class=\"text-[15px] leading-none\" data-kid=\"1-2-1-2-2-3-1-1-1\">\n                                    ✓\n                                </span>\n                            </span>\n                            <div data-kid=\"1-2-1-2-2-3-1-2\">\n                                <div class=\"text-[10px] font-semibold uppercase tracking-[0.09em] text-[#58705A]\" data-kid=\"1-2-1-2-2-3-1-2-1\">\n                                    Exemplo de resposta\n                                </div>\n                                <div class=\"mt-0.5 text-[13px] font-semibold tracking-[-0.02em] text-[#18382F] sm:text-[14px]\" data-kid=\"1-2-1-2-2-3-1-2-2\">\n                                    Resposta recebida\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"justify-self-end rounded-[8px] bg-white/75 px-2.5 py-1.5 text-[11px] font-medium text-[#4C6254] lg:ml-0 lg:justify-self-start lg:px-2.5 lg:py-2\" data-kid=\"1-2-1-2-2-3-2\">\n                            seu@email.com\n                        </div>\n                        <p class=\"col-span-2 mt-0.5 text-[11px] leading-[1.45] text-[#61745F] lg:col-span-1\" data-kid=\"1-2-1-2-2-3-3\">\n                            A resposta aparece organizada no painel.\n                        </p>\n                    </div>\n                </div>\n                <figcaption class=\"mt-3 text-[10px] leading-4 text-[#BAC9B9] sm:mt-3.5 sm:text-[11px]\" data-kid=\"1-2-1-2-3\">\n                    Uma demonstração visual — sem dados reais.\n                </figcaption>\n            </figure>\n        </section>\n        <section aria-labelledby=\"signup-title\" class=\"min-w-0 lg:border-l lg:border-[#D9DED2] lg:pl-10 xl:pl-12\" data-kid=\"1-2-2\">\n            <div class=\"mx-auto w-full max-w-[420px] lg:mx-0\" data-kid=\"1-2-2-1\">\n                <h2 class=\"signup-display text-[31px] leading-tight tracking-[-0.035em] text-[#18382F] sm:text-[34px]\" data-kid=\"1-2-2-1-1\" id=\"signup-title\">\n                    Crie sua conta\n                </h2>\n                <p class=\"mt-1.5 text-[14px] leading-6 text-[#65756B]\" data-kid=\"1-2-2-1-2\">\n                    Use seu email para começar a montar formulários.\n                </p>\n                <div class=\"hidden mt-5 items-start gap-3 rounded-[12px] border border-[#EBC7B9] bg-[#FFF2EC] px-4 py-3 text-[13px] leading-5 text-[#8E3E2B]\" data-dynamic=\"true\" data-kid=\"1-2-2-1-3\" data-name=\"signup error alert box\" data-reason=\"visible/hidden state toggled by form submission script\" id=\"signup-error\" role=\"alert\">\n                    <i aria-hidden=\"true\" class=\"icon-circle-alert mt-0.5 shrink-0 text-[16px]\" data-kid=\"1-2-2-1-3-1\" style=\"width:16px;height:16px\">\n                    </i>\n                    <span data-kid=\"1-2-2-1-3-2\">\n                        Não foi possível criar sua conta. Confira os dados e tente novamente.\n                    </span>\n                </div>\n                <form action=\"#\" class=\"mt-6 space-y-[18px] sm:mt-7\" data-kid=\"1-2-2-1-4\" id=\"signup-form\">\n                    <div data-kid=\"1-2-2-1-4-1\">\n                        <label class=\"mb-2 block text-[13px] font-semibold text-[#29463A]\" data-kid=\"1-2-2-1-4-1-1\" for=\"signup-email\">\n                            Email\n                        </label>\n                        <input autocomplete=\"email\" class=\"h-[52px] w-full rounded-[12px] border border-[#CDD5CA] bg-[#FFFEFA] px-4 text-[14px] text-[#18382F] shadow-[0_1px_2px_rgba(24,56,47,0.03)] outline-none placeholder:text-[#9AA39B] focus:border-[#D9684D] focus:ring-4 focus:ring-[#EFB29C]/35\" data-kid=\"1-2-2-1-4-1-2\" id=\"signup-email\" name=\"email\" placeholder=\"seu@email.com\" required=\"\" type=\"email\"/>\n                    </div>\n                    <div data-kid=\"1-2-2-1-4-2\">\n                        <label class=\"mb-2 block text-[13px] font-semibold text-[#29463A]\" data-kid=\"1-2-2-1-4-2-1\" for=\"signup-password\">\n                            Senha\n                        </label>\n                        <input autocomplete=\"new-password\" class=\"h-[52px] w-full rounded-[12px] border border-[#CDD5CA] bg-[#FFFEFA] px-4 text-[14px] tracking-[0.12em] text-[#18382F] shadow-[0_1px_2px_rgba(24,56,47,0.03)] outline-none placeholder:text-[#9AA39B] placeholder:tracking-[0.12em] focus:border-[#D9684D] focus:ring-4 focus:ring-[#EFB29C]/35\" data-kid=\"1-2-2-1-4-2-2\" id=\"signup-password\" minlength=\"6\" name=\"password\" placeholder=\"••••••••\" required=\"\" type=\"password\"/>\n                        <p class=\"mt-2 text-[12px] leading-5 text-[#65756B]\" data-kid=\"1-2-2-1-4-2-3\">\n                            Mínimo de 6 caracteres\n                        </p>\n                    </div>\n                    <button class=\"group mt-1 flex h-[54px] w-full items-center justify-center gap-2.5 rounded-[12px] bg-[#D9684D] px-5 text-[14px] font-semibold text-white shadow-[0_8px_18px_-11px_rgba(158,66,42,0.65)] outline-none focus-visible:ring-4 focus-visible:ring-[#D9684D]/30 hover:bg-[#C8583F] active:translate-y-px disabled:cursor-wait disabled:opacity-80\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-3\" data-name=\"signup form submission button\" data-reason=\"disabled state and spinner visibility toggled by form submission script\" id=\"signup-submit\" type=\"submit\">\n                        <span data-dynamic=\"true\" data-kid=\"1-2-2-1-4-3-1\" data-name=\"submit button label text\" data-reason=\"text changed to 'Criando conta...' by script\" id=\"signup-submit-label\">\n                            Criar conta\n                        </span>\n                        <i aria-hidden=\"true\" class=\"icon-arrow-right text-[16px] transition-transform group-hover:translate-x-0.5\" data-kid=\"1-2-2-1-4-3-2\" style=\"width:16px;height:16px\">\n                        </i>\n                        <span aria-hidden=\"true\" class=\"signup-spinner hidden h-4 w-4 rounded-full border-2 border-white/40 border-t-white\" data-dynamic=\"true\" data-kid=\"1-2-2-1-4-3-3\" data-name=\"loading spinner icon\" data-reason=\"visibility toggled by form submission script\" id=\"signup-spinner\">\n                        </span>\n                    </button>\n                </form>\n                <div class=\"mt-6 flex flex-wrap items-center justify-center gap-x-1.5 text-[13px] leading-6 text-[#65756B] sm:mt-7\" data-kid=\"1-2-2-1-5\">\n                    <span data-kid=\"1-2-2-1-5-1\">\n                        Já tem uma conta?\n                    </span>\n                    <a class=\"inline-flex min-h-[44px] items-center rounded-[7px] px-1 font-semibold text-[#18382F] underline decoration-[#C7D1C2] decoration-1 underline-offset-4 outline-none hover:text-[#C8583F] focus-visible:ring-2 focus-visible:ring-[#D9684D] focus-visible:ring-offset-2\" data-kid=\"1-2-2-1-5-2\" href=\"/login\">\n                        Fazer login\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n    <div aria-live=\"polite\" class=\"sr-only\" data-dynamic=\"true\" data-kid=\"1-3\" data-name=\"sr-only form status announcement\" data-reason=\"text content updated to communicate form status to screen readers\">\n        Estado de envio do botão: Criando conta...\n    </div>\n</div>\n",

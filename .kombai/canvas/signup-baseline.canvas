    "var_2a06ec067044": {
      "type": "variant",
      "label": "Cadastro — próximo passo e recuperação",
      "parentId": "var_2e6ccd97662e",
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 1000
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n</style>\n<main class=\"min-h-screen bg-[#f5f3ed] px-6 py-7 text-[#202d27] md:px-12 md:py-9\" data-kid=\"1\" data-name=\"main background container\" style=\"font-family:'DM Sans',sans-serif\">\n    <div class=\"mx-auto flex min-h-[calc(100vh-4.5rem)] w-full max-w-[1160px] flex-col\" data-kid=\"1-1\" data-name=\"page layout wrapper\">\n        <header class=\"flex items-center justify-between\" data-kid=\"1-1-1\" data-name=\"header navigation section\">\n            <a class=\"text-[15px] font-bold tracking-[-0.035em] text-[#1d352e]\" data-kid=\"1-1-1-1\" data-name=\"brand logo title\" href=\"#\" style=\"font-family:'Manrope',sans-serif\">\n                Form Builder\n                <span class=\"font-medium text-[#7b857d]\" data-kid=\"1-1-1-1-1\" data-name=\"brand subtitle\">\n                    Platform\n                </span>\n            </a>\n            <p class=\"text-sm text-[#68746c]\" data-kid=\"1-1-1-2\" data-name=\"login prompt text\">\n                Já tem uma conta?\n                <a class=\"ml-1 inline-flex min-h-11 items-center font-semibold text-[#1d5946] underline decoration-[#b6cbbd] underline-offset-4 hover:text-[#123f32] focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#346e56]\" data-kid=\"1-1-1-2-1\" data-name=\"login link button\" href=\"/login\">\n                    Fazer login\n                </a>\n            </p>\n        </header>\n        <section class=\"grid flex-1 items-center gap-12 pb-10 pt-12 lg:grid-cols-[minmax(0,1.1fr)_minmax(340px,0.9fr)] lg:gap-16 lg:py-14\" data-kid=\"1-1-2\" data-name=\"main content grid layout\">\n            <div class=\"w-full max-w-[500px]\" data-kid=\"1-1-2-1\" data-name=\"registration form container\">\n                <div class=\"mb-9\" data-kid=\"1-1-2-1-1\" data-name=\"form header section\">\n                    <h1 class=\"text-[38px] font-bold leading-[1.08] tracking-[-0.055em] text-[#1d352e] md:text-[44px]\" data-kid=\"1-1-2-1-1-1\" data-name=\"registration page title\" style=\"font-family:'Manrope',sans-serif\">\n                        Criar conta\n                    </h1>\n                    <p class=\"mt-3 max-w-[390px] text-[16px] leading-7 text-[#56645c]\" data-kid=\"1-1-2-1-1-2\" data-name=\"registration subheadline\">\n                        Crie sua conta para montar seu primeiro formulário.\n                    </p>\n                </div>\n                <div aria-live=\"polite\" class=\"mb-4 hidden rounded-[10px] border border-[#e4b3a9] bg-[#fff2ef] px-4 py-3 text-[13px] leading-5 text-[#842e24]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2\" data-name=\"error notification banner\" data-reason=\"visibility toggled by script on submission error\" id=\"signup-error\" role=\"alert\">\n                    Não foi possível criar sua conta. Confira os dados e tente novamente.\n                </div>\n                <form aria-label=\"Criar conta\" class=\"space-y-5\" data-kid=\"1-1-2-1-3\" data-signup-form=\"true\">\n                    <div data-kid=\"1-1-2-1-2-2\" data-name=\"email field container\">\n                        <label class=\"mb-2 block text-[14px] font-semibold text-[#26372f]\" data-kid=\"1-1-2-1-2-2-1\" data-name=\"email label\" for=\"email\">\n                            Email\n                        </label>\n                        <input autocomplete=\"email\" class=\"h-[54px] w-full rounded-[10px] border border-[#c9cec5] bg-white px-4 text-[15px] text-[#23352d] outline-none placeholder:text-[#929a91] focus:border-[#376b55] focus:ring-4 focus:ring-[#376b55]/15\" data-kid=\"1-1-2-1-2-2-2\" data-name=\"email input field\" id=\"email\" name=\"email\" placeholder=\"seu@email.com\" required=\"\" type=\"email\"/>\n                    </div>\n                    <div data-kid=\"1-1-2-1-2-3\" data-name=\"password field container\">\n                        <label class=\"mb-2 block text-[14px] font-semibold text-[#26372f]\" data-kid=\"1-1-2-1-2-3-1\" data-name=\"password label\" for=\"password\">\n                            Senha\n                        </label>\n                        <input autocomplete=\"new-password\" class=\"h-[54px] w-full rounded-[10px] border border-[#c9cec5] bg-white px-4 text-[15px] tracking-[0.12em] text-[#23352d] outline-none placeholder:text-[#929a91] focus:border-[#376b55] focus:ring-4 focus:ring-[#376b55]/15\" data-kid=\"1-1-2-1-2-3-2\" data-name=\"password input field\" id=\"password\" minlength=\"6\" name=\"password\" placeholder=\"••••••••\" required=\"\" type=\"password\"/>\n                        <p class=\"mt-2 text-[13px] leading-5 text-[#6e7971]\" data-kid=\"1-1-2-1-2-3-3\" data-name=\"password hint text\">\n                            Mínimo de 6 caracteres\n                        </p>\n                    </div>\n                    <button class=\"group mt-2 flex min-h-[54px] w-full items-center justify-center gap-3 rounded-[10px] bg-[#1d5946] px-5 text-[15px] font-bold text-white shadow-[0_7px_16px_rgba(29,89,70,0.14)] hover:bg-[#174b3b] focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-[#376b55] disabled:cursor-wait disabled:opacity-80\" data-kid=\"1-1-2-1-2-4\" data-name=\"submit account creation button\" type=\"submit\">\n                        <span data-kid=\"1-1-2-1-2-4-1\" data-submit-label=\"true\">\n                            Criar conta\n                        </span>\n                        <span aria-hidden=\"true\" class=\"text-[19px] leading-none transition-transform group-hover:translate-x-1\" data-kid=\"1-1-2-1-2-4-2\" data-submit-arrow=\"true\">\n                            →\n                        </span>\n                        <span aria-hidden=\"true\" class=\"hidden h-4 w-4 animate-spin rounded-full border-2 border-white/35 border-t-white\" data-dynamic=\"true\" data-kid=\"1-1-2-1-2-4-3\" data-name=\"submit button loading spinner\" data-reason=\"animation and visibility toggled by script on submission\" data-submit-spinner=\"true\">\n                        </span>\n                    </button>\n                </form>\n            </div>\n            <aside class=\"relative overflow-hidden rounded-[20px] bg-[#1e3d33] px-7 py-8 text-[#f6f4ec] shadow-[0_18px_44px_rgba(28,56,45,0.11)] md:px-9 md:py-10\" data-kid=\"1-1-2-2\" data-name=\"info card aside section\">\n                <div aria-hidden=\"true\" class=\"absolute right-[-54px] top-[-62px] h-[180px] w-[180px] rounded-full border border-white/10\" data-kid=\"1-1-2-2-1\" data-name=\"decorative outer circle\">\n                </div>\n                <div aria-hidden=\"true\" class=\"absolute right-[-24px] top-[-30px] h-[120px] w-[120px] rounded-full border border-white/10\" data-kid=\"1-1-2-2-2\" data-name=\"decorative inner circle\">\n                </div>\n                <div class=\"relative\" data-kid=\"1-1-2-2-3\" data-name=\"info card content wrapper\">\n                    <div data-after-panel=\"normal\" data-kid=\"1-1-2-2-3-4\">\n                        <h2 class=\"max-w-[300px] text-[27px] font-semibold leading-[1.15] tracking-[-0.04em] md:text-[30px]\" data-kid=\"1-1-2-2-3-1\" data-name=\"info card heading\" style=\"font-family:'Manrope',sans-serif\">\n                            O que acontece depois?\n                        </h2>\n                        <p class=\"mt-3 max-w-[335px] text-[14px] leading-6 text-[#d0d9d1]\" data-kid=\"1-1-2-2-3-2\" data-name=\"info card description\">\n                            Sua conta leva você ao painel, onde pode começar seu formulário.\n                        </p>\n                        <div class=\"mt-9 space-y-0\" data-kid=\"1-1-2-2-3-3\" data-name=\"process steps container\">\n                            <div class=\"flex gap-4 pb-6\" data-kid=\"1-1-2-2-3-3-1\" data-name=\"first step item\">\n                                <div aria-hidden=\"true\" class=\"flex w-7 shrink-0 flex-col items-center\" data-kid=\"1-1-2-2-3-3-1-1\" data-name=\"step connector container\">\n                                    <span class=\"mt-1 h-3 w-3 rounded-full border-[3px] border-[#d5ee94] bg-[#1e3d33]\" data-kid=\"1-1-2-2-3-3-1-1-1\" data-name=\"step bullet marker\">\n                                    </span>\n                                    <span class=\"mt-2 w-px flex-1 bg-white/20\" data-kid=\"1-1-2-2-3-3-1-1-2\" data-name=\"vertical line divider\">\n                                    </span>\n                                </div>\n                                <div class=\"pb-1\" data-kid=\"1-1-2-2-3-3-1-2\" data-name=\"first step details\">\n                                    <p class=\"text-[14px] font-semibold text-white\" data-kid=\"1-1-2-2-3-3-1-2-1\" data-name=\"first step title\">\n                                        Crie sua conta\n                                    </p>\n                                    <p class=\"mt-1 text-[13px] leading-5 text-[#b9c9bd]\" data-kid=\"1-1-2-2-3-3-1-2-2\" data-name=\"first step description\">\n                                        Informe email e senha para continuar.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-4 pb-6\" data-kid=\"1-1-2-2-3-3-2\" data-name=\"second step item\">\n                                <div aria-hidden=\"true\" class=\"flex w-7 shrink-0 flex-col items-center\" data-kid=\"1-1-2-2-3-3-2-1\" data-name=\"second step connector container\">\n                                    <span class=\"mt-1 h-3 w-3 rounded-full border-[3px] border-[#d5ee94] bg-[#1e3d33]\" data-kid=\"1-1-2-2-3-3-2-1-1\" data-name=\"second step bullet marker\">\n                                    </span>\n                                    <span class=\"mt-2 w-px flex-1 bg-white/20\" data-kid=\"1-1-2-2-3-3-2-1-2\" data-name=\"second step vertical divider\">\n                                    </span>\n                                </div>\n                                <div class=\"pb-1\" data-kid=\"1-1-2-2-3-3-2-2\" data-name=\"second step details\">\n                                    <p class=\"text-[14px] font-semibold text-white\" data-kid=\"1-1-2-2-3-3-2-2-1\" data-name=\"second step title\">\n                                        Acesse o painel\n                                    </p>\n                                    <p class=\"mt-1 text-[13px] leading-5 text-[#b9c9bd]\" data-kid=\"1-1-2-2-3-3-2-2-2\" data-name=\"second step description\">\n                                        Depois do cadastro, você vai direto para lá.\n                                    </p>\n                                </div>\n                            </div>\n                            <div class=\"flex gap-4\" data-kid=\"1-1-2-2-3-3-3\" data-name=\"third step item\">\n                                <div aria-hidden=\"true\" class=\"flex w-7 shrink-0 justify-center\" data-kid=\"1-1-2-2-3-3-3-1\" data-name=\"third step connector container\">\n                                    <span class=\"mt-1 h-3 w-3 rounded-full bg-[#d5ee94]\" data-kid=\"1-1-2-2-3-3-3-1-1\" data-name=\"third step bullet marker\">\n                                    </span>\n                                </div>\n                                <div data-kid=\"1-1-2-2-3-3-3-2\" data-name=\"third step details\">\n                                    <p class=\"text-[14px] font-semibold text-white\" data-kid=\"1-1-2-2-3-3-3-2-1\" data-name=\"third step title\">\n                                        Comece seu formulário\n                                    </p>\n                                    <p class=\"mt-1 text-[13px] leading-5 text-[#b9c9bd]\" data-kid=\"1-1-2-2-3-3-3-2-2\" data-name=\"third step description\">\n                                        Monte o primeiro com os campos que precisa.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"hidden max-w-[340px]\" data-after-panel=\"error\" data-dynamic=\"true\" data-kid=\"1-1-2-2-3-5\" data-name=\"info card error state container\" data-reason=\"visibility toggled by script on submission error\">\n                        <h2 class=\"text-[27px] font-semibold leading-[1.15] tracking-[-0.04em] md:text-[30px]\" data-kid=\"1-1-2-2-3-5-1\" data-name=\"info card error heading\" style=\"font-family:'Manrope',sans-serif\">\n                            Não foi possível criar sua conta.\n                        </h2>\n                        <p class=\"mt-4 text-[14px] leading-6 text-[#d0d9d1]\" data-kid=\"1-1-2-2-3-5-2\" data-name=\"info card error description text\">\n                            Confira os dados e tente novamente. Seus campos continuam disponíveis no formulário.\n                        </p>\n                        <a class=\"mt-7 inline-flex min-h-11 items-center font-semibold text-[#e0eeac] underline decoration-white/35 underline-offset-4 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white\" data-kid=\"1-1-2-2-3-5-3\" data-name=\"return to form link\" href=\"#email\">\n                            Voltar ao formulário\n                            <span aria-hidden=\"true\" class=\"ml-2\" data-kid=\"1-1-2-2-3-5-3-1\" data-name=\"diagonal arrow icon\">\n                                ↗\n                            </span>\n                        </a>\n                    </div>\n                </div>\n            </aside>\n        </section>\n        <footer class=\"flex items-center justify-between border-t border-[#dce0d8] pt-4 text-[12px] text-[#7a847b]\" data-kid=\"1-1-3\" data-name=\"footer section\">\n            <span data-kid=\"1-1-3-1\" data-name=\"footer brand name\">\n                Form Builder Platform\n            </span>\n            <span class=\"hidden sm:inline\" data-kid=\"1-1-3-2\" data-name=\"footer callout text\">\n                Formulários e respostas no mesmo lugar\n            </span>\n        </footer>\n    </div>\n</main>\n<script>\n    (() => {\n  const form = document.querySelector('[data-signup-form=\"true\"]');\n  const alert = document.querySelector('#signup-error');\n  const normalPanel = document.querySelector('[data-after-panel=\"normal\"]');\n  const errorPanel = document.querySelector('[data-after-panel=\"error\"]');\n  const button = form && form.querySelector('button[type=\"submit\"]');\n  const label = form && form.querySelector('[data-submit-label]');\n  const arrow = form && form.querySelector('[data-submit-arrow]');\n  const spinner = form && form.querySelector('[data-submit-spinner]');\n  const isError = new URLSearchParams(window.location.search).get('error') === 'registration_failed';\n\n  if (isError) {\n    alert.classList.remove('hidden');\n    normalPanel.classList.add('hidden');\n    errorPanel.classList.remove('hidden');\n  }\n\n  form.addEventListener('submit', (event) => {\n    event.preventDefault();\n    if (!form.reportValidity()) return;\n    button.disabled = true;\n    label.textContent = 'Criando conta…';\n    arrow.classList.add('hidden');\n    spinner.classList.remove('hidden');\n  });\n})();\n</script>\n",
      "comments": [],
